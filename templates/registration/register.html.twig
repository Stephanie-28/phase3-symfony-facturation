{% extends 'base.html.twig' %}
{% block title %}Register{% endblock %}
{% block body %}

<div class="min-h-screen bg-blue-300 flex items-center justify-center px-4 py-12">
  <div class="bg-white rounded-2xl shadow-md w-full max-w-lg px-10 py-10">

    {# Titre #}
    <h1 class="text-2xl font-bold text-center text-gray-900 mb-1">Créez votre compte</h1>
    <p class="text-center text-sm text-gray-500 mb-8">
      Ou <a href="{{ path('app_login') }}" class="text-blue-500 hover:underline">connectez-vous à votre compte</a>
    </p>

    {{ form_errors(registrationForm) }}
    {{ form_start(registrationForm, {
      attr: { class: 'space-y-4' }
    }) }}

      {# Prénom + Nom côte à côte #}
      <div class="flex gap-4">
        <div class="flex-1">
          <label class="block text-xs font-medium text-gray-600 mb-1">Prénom</label>
          {{ form_widget(registrationForm.first_name, {
            attr: { class: 'w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-400', placeholder: 'Alex' }
          }) }}
          {{ form_errors(registrationForm.first_name) }}
        </div>
        <div class="flex-1">
          <label class="block text-xs font-medium text-gray-600 mb-1">Nom</label>
          {{ form_widget(registrationForm.last_name, {
            attr: { class: 'w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-400', placeholder: 'Legrand' }
          }) }}
          {{ form_errors(registrationForm.last_name) }}
        </div>
      </div>

      {# Company Name #}
      <div>
        <label class="block text-xs font-medium text-gray-600 mb-1">Company Name</label>
        {{ form_widget(registrationForm.company_name, {
          attr: { class: 'w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-400', placeholder: 'Tech Solutions' }
        }) }}
        {{ form_errors(registrationForm.company_name) }}
      </div>

      {# IBAN #}
      <div>
        <label class="block text-xs font-medium text-gray-600 mb-1">IBAN</label>
        {{ form_widget(registrationForm.IBAN, {
          attr: { class: 'w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-400', placeholder: 'FR76 1234 5678 9012 3456 7890 123' }
        }) }}
        {{ form_errors(registrationForm.IBAN) }}
      </div>

      {# Adresse Email #}
      <div>
        <label class="block text-xs font-medium text-gray-600 mb-1">Adresse Email</label>
        {{ form_widget(registrationForm.email, {
          attr: { class: 'w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-400', placeholder: 'contact@entreprise.fr' }
        }) }}
        {{ form_errors(registrationForm.email) }}
      </div>

      {# Mot de passe #}
      <div>
        <label class="block text-xs font-medium text-gray-600 mb-1">Mot de passe</label>
        {{ form_widget(registrationForm.plainPassword, {
          attr: { class: 'w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-400', placeholder: 'password' }
        }) }}
        {{ form_errors(registrationForm.plainPassword) }}
      </div>

      {# AgreeTerms #}
      <div class="flex items-center gap-2 text-sm text-gray-600">
        {{ form_widget(registrationForm.agreeTerms, {
          attr: { class: 'w-4 h-4 accent-blue-500' }
        }) }}
        {{ form_label(registrationForm.agreeTerms, null, { label_attr: { class: 'cursor-pointer' } }) }}
        {{ form_errors(registrationForm.agreeTerms) }}
      </div>

      {# Bouton #}
      <button type="submit"
        class="w-full bg-blue-500 hover:bg-blue-600 text-white font-semibold py-2.5 rounded-lg text-sm transition-colors duration-200 mt-2">
        Créer mon compte
      </button>

    {{ form_end(registrationForm) }}

  </div>
</div>

{% endblock %}