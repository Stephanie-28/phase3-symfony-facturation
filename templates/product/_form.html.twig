{{ form_start(form, { attr: { class: "space-y-4" } }) }}

<div>
    <label class="block text-sm font-medium text-gray-700 mb-1">Nom</label>
    {{
        form_widget(form.name, {
            attr: {
                class: "w-full border border-gray-200 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-400",
            },
        })
    }}
    {{ form_errors(form.name) }}
</div>

<div>
    <label class="block text-sm font-medium text-gray-700 mb-1"
        >Description</label
    >
    {{
        form_widget(form.description, {
            attr: {
                class: "w-full border border-gray-200 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-400",
                rows: 3,
            },
        })
    }}
    {{ form_errors(form.description) }}
</div>

<div class="flex gap-4">
    <div class="flex-1">
        <label class="block text-sm font-medium text-gray-700 mb-1">Prix</label>
        {{
            form_widget(form.price, {
                attr: {
                    class: "w-full border border-gray-200 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-400",
                },
            })
        }}
        {{ form_errors(form.price) }}
    </div>
    <div class="flex-1">
        <label class="block text-sm font-medium text-gray-700 mb-1"
            >Unité</label
        >
        {{
            form_widget(form.Unit, {
                attr: {
                    class: "w-full border border-gray-200 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-400",
                },
            })
        }}
        {{ form_errors(form.Unit) }}
    </div>
</div>

<div class="flex justify-end gap-3 pt-2">
    <a
        href="{{ path('app_product_index') }}"
        class="px-5 py-2 text-sm font-medium text-gray-700 border border-gray-200 rounded-lg hover:bg-gray-50 transition-colors"
    >
        Annuler
    </a>
    <button
        type="submit"
        class="px-5 py-2 text-sm font-semibold text-white bg-blue-500 hover:bg-blue-600 rounded-lg transition-colors"
    >
        Enregistrer
    </button>
</div>

{{ form_end(form) }}
