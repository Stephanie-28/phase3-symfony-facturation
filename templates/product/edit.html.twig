{% extends 'base.html.twig' %}
{% block title %}Modifier un produit{% endblock %}
{% block body %}

<div class="p-8 max-w-2xl mx-auto">
  <h1 class="text-2xl font-bold text-gray-900 text-center mb-6">MODIFIER UN PRODUIT</h1>

  <div class="bg-white rounded-2xl shadow-sm p-8">
    <div class="flex items-center justify-between mb-6">
      <h2 class="text-lg font-bold text-gray-900">Modifier le produit</h2>
      <a href="{{ path('app_product_index') }}" class="text-gray-400 hover:text-gray-600 text-xl">✕</a>
    </div>

    {{ include('product/_form.html.twig', {'button_label': 'Mettre à jour'}) }}

    <div class="mt-6 pt-6 border-t border-gray-100">
      {{ include('product/_delete_form.html.twig') }}
    </div>
  </div>
</div>

{% endblock %}