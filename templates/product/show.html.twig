{% extends 'base.html.twig' %}
{% block title %}Produit{% endblock %}
{% block body %}

<div class="p-8 max-w-2xl mx-auto">
  <h1 class="text-2xl font-bold text-gray-900 mb-6">Produit</h1>

  <div class="bg-white rounded-2xl shadow-sm overflow-hidden mb-6">
    <table class="w-full">
      <tbody>
        <tr class="border-b border-gray-50">
          <th class="text-left text-sm font-semibold text-gray-500 px-6 py-4 w-1/3">Id</th>
          <td class="text-sm text-gray-900 px-6 py-4">{{ product.id }}</td>
        </tr>
        <tr class="border-b border-gray-50">
          <th class="text-left text-sm font-semibold text-gray-500 px-6 py-4">Nom</th>
          <td class="text-sm text-gray-900 px-6 py-4">{{ product.name }}</td>
        </tr>
        <tr class="border-b border-gray-50">
          <th class="text-left text-sm font-semibold text-gray-500 px-6 py-4">Description</th>
          <td class="text-sm text-gray-900 px-6 py-4">{{ product.description }}</td>
        </tr>
        <tr class="border-b border-gray-50">
          <th class="text-left text-sm font-semibold text-gray-500 px-6 py-4">Prix</th>
          <td class="text-sm text-gray-900 px-6 py-4">{{ product.price }} €</td>
        </tr>
        <tr>
          <th class="text-left text-sm font-semibold text-gray-500 px-6 py-4">Unité</th>
          <td class="text-sm text-gray-900 px-6 py-4">{{ product.Unit.value }}</td>
        </tr>
      </tbody>
    </table>
  </div>
  <div class="flex items-center gap-3">
    <a href="{{ path('app_product_index') }}"
      class="px-5 py-2 text-sm font-medium text-gray-700 border border-gray-200 rounded-lg hover:bg-gray-50 transition-colors">
      ← Retour à la liste
    </a>

    {{ include('product/_delete_form.html.twig') }}
  </div>
</div>

{% endblock %}