{% extends 'base.html.twig' %}
{% block title %}Mon Profil{% endblock %}
{% block body %}

<div class="min-h-screen bg-blue-300 flex items-start justify-center px-4 py-12">
  <div class="w-full max-w-2xl">

    <h1 class="text-2xl font-bold text-gray-900 mb-6">Mon Profil</h1>

    <div class="bg-white rounded-2xl shadow-sm p-8">

      {{ form_start(form, { attr: { class: 'space-y-6' } }) }}

        {# Raison Sociale #}
        <div>
          <label class="block text-sm font-medium text-gray-700 mb-1">Raison Sociale</label>
          {{ form_widget(form.company_name, {
            attr: { class: 'w-full border border-gray-200 rounded-xl px-4 py-3 text-sm focus:outline-none focus:ring-2 focus:ring-blue-400', placeholder: 'Tech Solutions' }
          }) }}
          {{ form_errors(form.company_name) }}
          <p class="mt-1 text-xs text-blue-500">Le nom de votre entreprise qui apparaîtra sur vos factures.</p>
        </div>

        {# Siret #}
        <div>
          <label class="block text-sm font-medium text-gray-700 mb-1">Numéro SIRET (Optionnel)</label>
          {{ form_widget(form.siret, {
            attr: { class: 'w-full border border-gray-200 rounded-xl px-4 py-3 text-sm focus:outline-none focus:ring-2 focus:ring-blue-400', placeholder: '' }
          }) }}
          {{ form_errors(form.siret) }}
        </div>

        {# IBAN #}
        <div>
          <label class="block text-sm font-medium text-gray-700 mb-1">IBAN</label>
          {{ form_widget(form.IBAN, {
            attr: { class: 'w-full border border-gray-200 rounded-xl px-4 py-3 text-sm focus:outline-none focus:ring-2 focus:ring-blue-400', placeholder: 'FR76 1234 5678 9012 3456 7890 123' }
          }) }}
          {{ form_errors(form.IBAN) }}
          <p class="mt-1 text-xs text-gray-400">Compte bancaire qui recevra les virements de vos clients.</p>
        </div>

        {# CGV #}
        <div>
          <label class="block text-sm font-medium text-gray-700 mb-1">Conditions Générales de Vente (CGV)</label>
          {{ form_widget(form.CGV, {
            attr: {
              class: 'w-full border border-gray-200 rounded-xl px-4 py-3 text-sm focus:outline-none focus:ring-2 focus:ring-blue-400 resize-none',
              placeholder: 'Ces conditions apparaîtront en bas de vos factures PDF...',
              rows: 5
            }
          }) }}
          {{ form_errors(form.CGV) }}
        </div>

        <button type="submit"
          class="bg-blue-500 hover:bg-blue-600 text-white font-semibold px-6 py-2.5 rounded-lg text-sm transition-colors duration-200">
          Enregistrer les modifications
        </button>

      {{ form_end(form) }}

    </div>
  </div>
</div>

{% endblock %}